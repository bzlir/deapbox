# deapbox 配置文件示例
#
# 推荐初始化方式：
#   deapbox setup            # 无凭证 → 扫码自动创建飞书应用（NEW 模式）
#   deapbox setup bind --app cli_xxx:sec_xxx   # 已有凭证 → 校验后写回（BIND 模式）
#
# 手动初始化（参考本文件）：
#   cp config.toml.example config.toml  再填值
#
# config.toml 已在 .gitignore 中，不入库（含 Lark app_secret 等敏感信息）。

[lark]
# 飞书自建应用凭证：https://open.feishu.cn/app
app_id = "cli_xxxxxxxxxxxxxxxx"
app_secret = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Agent 定义列表。kind 可选：opencode / codex / claude-code / kimi-code
[[agents]]
id = "claude-main"
kind = "claude-code"
command = "claude"
# args = ["--model", "sonnet"]
# env_vars = { ANTHROPIC_API_KEY = "sk-..." }

[[agents]]
id = "kimi-main"
kind = "kimi-code"
command = "kimi"

# 首启 session 绑定（可选；运行后由 /switch 等命令动态修改，存于 sled）
# [[sessions]]
# chat_id = "oc_xxxxxxxxxxxxxxxx"
# agent_id = "claude-main"
# workspace = "/Users/me/lab/my-project"
